{
  "name": "hevy-coach",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "chat": "tsx scripts/chat.ts",
    "evaluate:effort": "tsx scripts/evaluate-effort.ts",
    "evaluate:effort:pair": "tsx scripts/evaluate-effort.ts pair 5",
    "evaluate:effort:production": "tsx scripts/evaluate-effort.ts production 1",
    "recover:hevy": "tsx scripts/reconcile-pending-hevy-mutation.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop hevy-coach",
    "pm2:restart": "pm2 restart hevy-coach",
    "pm2:logs": "pm2 logs hevy-coach",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
